{
  "manifest_version": 3,
  "name": "Хватит — блокировщик сайтов",
  "short_name": "Хватит",
  "description": "Блокируй отвлекающие сайты. Вместо них — 🖕 и напоминание вернуться к делу.",
  "version": "1.0.0",
  "minimum_chrome_version": "101",
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {
    "default_title": "Хватит — заблокировать сайт",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["http://*/*", "https://*/*"]}],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"}
}
